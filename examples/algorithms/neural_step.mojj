x =: 1 2
target =: 1.0
rate =: 0.1
W =: 2 3 reshape 1 _1 0.5 0 0.25 0.5
w =: 0.5 1 _1

z =: x dot W
h =: 0 max z
prediction =: h dot w
err =: prediction - target
loss =: 0.5 * square err

dw =: err * h
dz =: (err * w) * (z greater 0)
dW =: x times table dz
W =: W - rate * dW
w =: w - rate * dw

loss
newPrediction =: (0 max (x dot W)) dot w
0.5 * square (newPrediction - target)
